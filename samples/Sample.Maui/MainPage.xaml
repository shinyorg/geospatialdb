<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Sample.Maui.MainPage"
    Title="Spatial GPS">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="20" RowSpacing="15">

        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Button
                x:Name="ToggleButton"
                Text="Start GPS"
                Clicked="OnToggleClicked" />

            <Button
                Text="Get Current"
                Clicked="OnGetCurrentClicked" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="5">
            <Label Text="Last Event:" FontAttributes="Bold" />
            <Label x:Name="CurrentStateLabel" Text="--" FontSize="24" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="3" Spacing="5">
            <Label Text="Get Current Result:" FontAttributes="Bold" />
            <Label x:Name="GetCurrentLabel" Text="--" FontSize="18" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="4" Spacing="5">
            <Label Text="Change History:" FontAttributes="Bold" />
            <CollectionView x:Name="HistoryList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" Padding="0,4" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
